{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ocr.dev/schemas/error-v2.schema.json",
  "title": "Open OCR error v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "category", "message", "retryable"],
  "properties": {
    "code": {
      "enum": [
        "INPUT_NOT_FOUND",
        "INPUT_INVALID",
        "CONFIG_INVALID",
        "AUTH_MISSING",
        "AUTH_INVALID",
        "PERMISSION_DENIED",
        "SCHEMA_INVALID",
        "OUTPUT_CONFLICT",
        "OUTPUT_INVALID",
        "RATE_LIMITED",
        "TIMEOUT",
        "COST_LIMIT",
        "CANCELLED",
        "NOT_RUN",
        "PROVIDER_FAILURE",
        "INTERNAL"
      ]
    },
    "category": {
      "enum": ["input", "configuration", "authentication", "authorization", "schema", "output", "provider", "limit", "cancelled", "execution", "internal"]
    },
    "message": { "type": "string", "minLength": 1 },
    "retryable": { "type": "boolean" },
    "hint": { "type": "string", "minLength": 1 }
  }
}
