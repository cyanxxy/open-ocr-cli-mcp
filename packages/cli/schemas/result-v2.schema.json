{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-ocr.dev/schemas/result-v2.schema.json",
  "title": "Open OCR job result v2",
  "oneOf": [{ "$ref": "#/$defs/success" }, { "$ref": "#/$defs/failure" }],
  "$defs": {
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "inputTokens", "outputTokens", "thoughtTokens", "toolTokens", "cachedTokens", "totalTokens", "estimatedCostUsd"],
      "properties": {
        "requests": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": "integer", "minimum": 0 },
        "outputTokens": { "type": "integer", "minimum": 0 },
        "thoughtTokens": { "type": "integer", "minimum": 0 },
        "toolTokens": { "type": "integer", "minimum": 0 },
        "cachedTokens": { "type": "integer", "minimum": 0 },
        "totalTokens": { "type": "integer", "minimum": 0 },
        "estimatedCostUsd": { "type": "number", "minimum": 0 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mediaType", "kind"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["markdown", "json", "csv", "agent-steps"] }
      }
    },
    "progressStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status"],
      "properties": {
        "kind": { "enum": ["runtime", "thought_summary", "reasoning", "model_output", "tool_call", "tool_result", "error"] },
        "status": { "enum": ["started", "in_progress", "completed", "failed", "skipped"] },
        "stepId": { "type": "string", "minLength": 1 },
        "callId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "text": { "type": "string" },
        "delta": { "type": "boolean" },
        "arguments": { "type": "object" },
        "result": {},
        "error": { "$ref": "error-v2.schema.json" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "delta": { "const": true } },
            "required": ["delta"]
          },
          "then": { "required": ["stepId", "text"] }
        },
        {
          "if": { "properties": { "kind": { "const": "tool_call" } }, "required": ["kind"] },
          "then": {
            "required": ["callId", "name"],
            "properties": { "status": { "const": "started" } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "tool_result" } }, "required": ["kind"] },
          "then": {
            "required": ["callId", "name"],
            "properties": { "status": { "enum": ["completed", "failed"] } }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "enum": ["runtime", "thought_summary", "reasoning", "model_output", "error"] }
            },
            "required": ["kind"]
          },
          "then": { "required": ["text"] }
        }
      ]
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "markdown": { "type": "string" },
        "json": {},
        "csv": { "type": "string" },
        "agentSteps": { "type": "array", "items": { "$ref": "#/$defs/progressStep" } }
      },
      "minProperties": 1
    },
    "agenticField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence"],
      "properties": {
        "value": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "valid": { "type": "boolean" },
        "validationMessage": { "type": "string" },
        "validationRule": { "type": "string" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["page", "x", "y", "width", "height", "units"],
          "properties": {
            "page": { "type": "integer", "minimum": 1 },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" },
            "units": { "const": "normalized" }
          }
        }
      }
    },
    "agenticResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentType", "pageCount", "complexity", "specialFeatures", "confidence", "iterations", "stopReason", "fields"],
      "properties": {
        "documentType": { "type": "string" },
        "pageCount": { "type": "integer", "minimum": 0 },
        "complexity": { "enum": ["low", "medium", "high"] },
        "specialFeatures": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "iterations": { "type": "integer", "minimum": 0 },
        "stopReason": { "enum": ["succeeded", "partial", "max_iterations", "tool_limit_reached", "budget_exhausted", "cost_limit_reached", "cancelled", "failed"] },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/agenticField" } }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "source", "status", "mode", "provider", "gateway", "model", "startedAt", "completedAt", "durationMs", "attempts", "artifacts", "plannedArtifacts"],
      "properties": {
        "documentId": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "status": { "enum": ["succeeded", "partial", "failed", "skipped"] },
        "mode": { "enum": ["simple", "template", "agentic"] },
        "provider": { "enum": ["gemini", "kimi", "muse", "openrouter", "openai-compatible"] },
        "gateway": { "enum": ["direct", "cloudflare"] },
        "model": { "type": "string", "minLength": 1 },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "attempts": { "type": "integer", "minimum": 0 },
        "skipReason": { "enum": ["validated", "resumed", "cancelled", "cost-limit", "fail-fast"] },
        "partialReason": { "enum": ["readiness_not_met", "max_iterations", "tool_limit_reached", "time_budget_reached", "cost_limit_reached", "validation_failed"] },
        "nextAction": { "enum": ["review_partial_output", "increase_max_iterations", "retry_document", "increase_timeout", "increase_max_cost"] },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "plannedArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
        "content": { "$ref": "#/$defs/content" },
        "warnings": { "$ref": "#/$defs/warnings" },
        "error": { "$ref": "error-v2.schema.json" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
          "then": { "required": ["error"] }
        },
        {
          "if": { "properties": { "mode": { "const": "agentic" } }, "required": ["mode"] },
          "then": {
            "properties": {
              "content": {
                "type": "object",
                "properties": { "json": { "$ref": "#/$defs/agenticResult" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
          "then": { "required": ["partialReason", "nextAction"] }
        }
      ]
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "ok", "runId", "status", "startedAt", "completedAt", "durationMs", "total", "succeeded", "partial", "failed", "skipped", "mode", "provider", "gateway", "model", "usage", "costLimitReached", "warnings", "documents"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "type": { "const": "run.result" },
        "ok": { "type": "boolean" },
        "runId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["succeeded", "partial", "failed", "validated", "cancelled", "cost_limited"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "durationMs": { "type": "number", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "succeeded": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["simple", "template", "agentic"] },
        "provider": { "enum": ["gemini", "kimi", "muse", "openrouter", "openai-compatible"] },
        "gateway": { "enum": ["direct", "cloudflare"] },
        "model": { "type": "string", "minLength": 1 },
        "usage": { "$ref": "#/$defs/usage" },
        "costLimitUsd": { "type": "number", "exclusiveMinimum": 0 },
        "costLimitReached": { "type": "boolean" },
        "warnings": { "$ref": "#/$defs/warnings" },
        "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["succeeded", "validated"] } }, "required": ["status"] },
          "then": { "properties": { "ok": { "const": true } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["partial", "failed", "cancelled", "cost_limited"] } }, "required": ["status"] },
          "then": { "properties": { "ok": { "const": false } } }
        }
      ]
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "type", "ok", "runId", "status", "error"],
      "properties": {
        "protocolVersion": { "const": 2 },
        "type": { "const": "run.result" },
        "ok": { "const": false },
        "runId": { "type": "string", "minLength": 1 },
        "status": { "const": "failed" },
        "warnings": { "$ref": "#/$defs/warnings" },
        "error": { "$ref": "error-v2.schema.json" }
      }
    }
  }
}
